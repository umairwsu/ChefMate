<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color -->
    <solid android:color="#FFFFFFFF" />

    <!-- Border color -->
    <stroke
        android:width="1dp"
        android:color="#FF6901" />

    <!-- Corner radius -->
    <corners android:radius="12dp" />

    <!-- Optional padding -->
    <padding
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp" />

    <!-- Light shadow-like effect -->
    <size android:height="48dp" />

</shape>