<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context="com.example.chefmateapp.BoardingActivity">

    <ImageView
        android:id="@+id/boarding_iv"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.152"
        app:srcCompat="@drawable/br1" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/titleTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="21dp"
        android:fontFamily="@font/made_tommy_regular"
        android:gravity="center"
        android:maxLines="2"
        android:text="Get all the healthy recipes
that you need"
        android:textColor="@color/black"
        android:textSize="18dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/boarding_iv"
        app:layout_constraintVertical_bias="0.16000003" />

    <TextView
        android:id="@+id/disTv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="21dp"
        android:fontFamily="@font/made_tommy_regular"
        android:gravity="center"
        android:maxLines="2"
        android:layout_marginTop="14dp"
        android:text="Whether you are losing or gaining, we have AI-powered recipes for you"
        android:textColor="#8C8C8C"
        android:textSize="14dp"
        android:textStyle="normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTv" />

    <ImageView
        android:id="@+id/nextBtn"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:srcCompat="@drawable/next_ic"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/disTv" />

    <Button
        android:id="@+id/stBtn"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:backgroundTint="#FF6901"
        android:textColor="@color/white"
        android:text="GET STARTED"
        android:visibility="gone"
        android:textStyle="bold"
        app:layout_constraintWidth_percent="0.8"
        android:fontFamily="@font/made_tommy_regular"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/disTv" />
</androidx.constraintlayout.widget.ConstraintLayout>